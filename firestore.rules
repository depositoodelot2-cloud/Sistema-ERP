rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation document
    match /test/{docId} {
      allow read, write: if true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if true;
      allow write: if isValidId(customerId);
    }

    // Sales transactions collection
    match /sales/{saleId} {
      allow read: if true;
      allow write: if isValidId(saleId);
    }

    // Operators collection
    match /operators/{operatorId} {
      allow read: if true;
      allow write: if isValidId(operatorId);
    }

    // Settings collection
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId);
    }
  }
}
